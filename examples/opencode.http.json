{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "fattureincloud": {
      "type": "remote",
      "url": "https://host.example/fic/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:MCP_GATEWAY_TOKEN}",
        "X-FIC-Token": "{env:FIC_ACCESS_TOKEN}",
        "X-FIC-Company": "{env:FIC_COMPANY_ID}"
      }
    }
  }
}
